{
  "name": "astro-components",
  "private": true,
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "changeset": "changeset",
    "check": "pnpm --filter './packages/*' exec tsc --noEmit",
    "format": "pnpm run format:code",
    "format:check": "prettier --check .",
    "format:ci": "pnpm run format:check",
    "format:code": "prettier -w --cache '**/*' --ignore-unknown",
    "test": "node --test tests/*.test.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "version": "changeset version && pnpm install --no-frozen-lockfile && pnpm run format"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  }
}
